      Group #TabActiveStorage { Anchor: (Left: 0, Top: 352, Width: 148, Height: 2); Background: #d8b86a; Visible: false; }
      TextButton #TabBackpack { Anchor: (Left: 160, Top: 326, Width: 148, Height: 26); Style: @Control; Padding: (Horizontal: 4); Text: "Backpack"; }
      Group #TabActiveBackpack { Anchor: (Left: 160, Top: 352, Width: 148, Height: 2); Background: #d8b86a; Visible: false; }
      TextButton #TabHotbar { Anchor: (Left: 320, Top: 326, Width: 148, Height: 26); Style: @Control; Padding: (Horizontal: 4); Text: "Hotbar"; }
      Group #TabActiveHotbar { Anchor: (Left: 320, Top: 352, Width: 148, Height: 2); Background: #d8b86a; Visible: false; }
