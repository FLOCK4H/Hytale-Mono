$C = "../Common.ui";
@Slot = ButtonStyle(Default: (Background: #1b2a3a), Hovered: (Background: #344f65), Pressed: (Background: #526b80), Disabled: (Background: #172332));
@ControlLabel = LabelStyle(FontName: "Secondary", FontSize: 12, RenderBold: true, TextColor: #d4e1e8, HorizontalAlignment: Center, VerticalAlignment: Center);
@Control = TextButtonStyle(Default: (Background: #273b52, LabelStyle: @ControlLabel), Hovered: (Background: #3b5570, LabelStyle: @ControlLabel), Pressed: (Background: #536c82, LabelStyle: @ControlLabel), Disabled: (Background: #1b2a3c, LabelStyle: (...@ControlLabel, TextColor: #8398a8)), Sounds: $C.@ButtonSounds);
@Tooltip = TextTooltipStyle(Background: (TexturePath: "../Common/TooltipDefaultBackground.png", Border: 24), MaxWidth: 280, LabelStyle: (Wrap: true, FontSize: 14), Padding: 16);
Group { Background: #070d16(0.36); }
$C.@Container #Satchel {
  @CloseButton = false;
  Anchor: (Width: 516, Height: 756);
  #Title { Anchor: (Height: 44, Top: 0); Padding: (Full: 0); Label { Anchor: (Left: 24, Top: 0, Width: 360, Height: 44); Text: "ASTRAL SATCHEL"; Style: (...$C.@TitleStyle, FontSize: 18, HorizontalAlignment: Start); } TextButton #Close { Anchor: (Right: 24, Top: 8, Width: 64, Height: 28); Style: @Control; Text: "Close"; } }
  #Content { Anchor: (Top: 44); LayoutMode: Full; Padding: (Full: 0);
    Group #Body { Anchor: (Left: 24, Top: 12, Width: 468, Height: 684); LayoutMode: Full;
      TextField #SatchelKeyboard { Anchor: (Left: 0, Top: 0, Width: 1, Height: 1); AutoFocus: true; HitTestVisible: false; MaxLength: 1; Background: #070d16(0); Style: (FontSize: 1, TextColor: #d4e1e8(0)); Value: ""; }
      TextField #Search { Anchor: (Left: 0, Top: 0, Width: 384, Height: 30); Style: $C.@DefaultInputFieldStyle; PlaceholderStyle: (FontSize: 14, TextColor: #b9cedd); Background: $C.@InputBoxBackground; Padding: (Horizontal: 10); PlaceholderText: "Search by item name"; MaxLength: 80; }
      TextButton #Refresh { Anchor: (Left: 392, Top: 0, Width: 76, Height: 30); Style: @Control; Padding: (Horizontal: 4); Text: "Refresh"; }
      Label #Summary { Anchor: (Left: 0, Top: 36, Width: 354, Height: 18); Text: ""; Style: (FontSize: 12, TextColor: #b9cedd, Wrap: true, HorizontalAlignment: Start); }
      Button #TakeVisible { Anchor: (Left: 370, Top: 32, Width: 30, Height: 24); Style: @Slot; TextTooltipStyle: @Tooltip; TooltipText: "Take all visible Satchel items into inventory";
        Group #TakeVisibleIcon { Anchor: (Left: 4, Top: 1, Width: 22, Height: 22); Background: (TexturePath: "../AxoTales/Astral/TakeVisible.png"); HitTestVisible: false; }
      }
      Button #StoreVisible { Anchor: (Left: 404, Top: 32, Width: 30, Height: 24); Style: @Slot; TextTooltipStyle: @Tooltip; TooltipText: "Store all visible inventory items in the Satchel";
        Group #StoreVisibleIcon { Anchor: (Left: 4, Top: 1, Width: 22, Height: 22); Background: (TexturePath: "../AxoTales/Astral/StoreVisible.png"); HitTestVisible: false; }
      }
      Button #Quickstack { Anchor: (Left: 438, Top: 32, Width: 30, Height: 24); Style: @Slot; TextTooltipStyle: @Tooltip; TooltipText: "Quickstack visible inventory into types already stored in the Satchel";
        Group #QuickstackIcon { Anchor: (Left: 4, Top: 1, Width: 22, Height: 22); Background: (TexturePath: "../AxoTales/Astral/Quickstack.png"); HitTestVisible: false; }
      }
      TextField #BulkToken { Visible: false; Value: ""; }
      TextButton #FilterAll { Anchor: (Left: 0, Top: 60, Width: 46, Height: 26); Style: @Control; Padding: (Horizontal: 4); Text: "All"; }
      Group #ActiveAll { Anchor: (Left: 0, Top: 86, Width: 46, Height: 2); Background: #d8b86a; Visible: false; }
      TextButton #FilterMaterials { Anchor: (Left: 50, Top: 60, Width: 78, Height: 26); Style: @Control; Padding: (Horizontal: 4); Text: "Materials"; }
      Group #ActiveMaterials { Anchor: (Left: 50, Top: 86, Width: 78, Height: 2); Background: #d8b86a; Visible: false; }
      TextButton #FilterEquipment { Anchor: (Left: 132, Top: 60, Width: 86, Height: 26); Style: @Control; Padding: (Horizontal: 4); Text: "Equipment"; }
      Group #ActiveEquipment { Anchor: (Left: 132, Top: 86, Width: 86, Height: 2); Background: #d8b86a; Visible: false; }
      TextButton #FilterBuilding { Anchor: (Left: 222, Top: 60, Width: 74, Height: 26); Style: @Control; Padding: (Horizontal: 4); Text: "Building"; }
      Group #ActiveBuilding { Anchor: (Left: 222, Top: 86, Width: 74, Height: 2); Background: #d8b86a; Visible: false; }
      TextButton #FilterConsumables { Anchor: (Left: 300, Top: 60, Width: 102, Height: 26); Style: @Control; Padding: (Horizontal: 4); Text: "Consumables"; }
      Group #ActiveConsumables { Anchor: (Left: 300, Top: 86, Width: 102, Height: 2); Background: #d8b86a; Visible: false; }
      TextButton #FilterOther { Anchor: (Left: 406, Top: 60, Width: 62, Height: 26); Style: @Control; Padding: (Horizontal: 4); Text: "Other"; }
      Group #ActiveOther { Anchor: (Left: 406, Top: 86, Width: 62, Height: 2); Background: #d8b86a; Visible: false; }
      Label #Result { Anchor: (Left: 0, Top: 94, Width: 468, Height: 18); Text: ""; Style: (FontSize: 12, TextColor: #b9cedd, Wrap: true, HorizontalAlignment: Start); }
      Group #BagGrid { Anchor: (Left: 0, Top: 116, Width: 468, Height: 156); LayoutMode: Full;
