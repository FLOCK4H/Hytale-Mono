      TextButton #InventoryPrevious { Anchor: (Left: 0, Top: 598, Width: 84, Height: 24); Style: @Control; Padding: (Horizontal: 4); Text: "Previous"; }
      TextButton #InventoryNext { Anchor: (Left: 384, Top: 598, Width: 84, Height: 24); Style: @Control; Padding: (Horizontal: 4); Text: "Next"; }
      Label #Status { Anchor: (Left: 0, Top: 630, Width: 468, Height: 32); Text: ""; Style: (FontSize: 12, TextColor: #b9cedd, Wrap: true, HorizontalAlignment: Center); }
      Label #TransferHelp { Anchor: (Left: 0, Top: 668, Width: 468, Height: 16); Text: "LMB: stack  |  RMB: one  |  Filters change the view only"; Style: (FontSize: 11, TextColor: #b9cedd, Wrap: true, HorizontalAlignment: Center); }
