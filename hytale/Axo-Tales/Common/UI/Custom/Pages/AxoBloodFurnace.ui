$C = "../Common.ui";
@Slot = ButtonStyle(Default: (Background: #24374a), Hovered: (Background: #405b70), Pressed: (Background: #567386), Disabled: (Background: #1b2a3b));
@ControlLabel = LabelStyle(FontName: "Secondary", FontSize: 12, RenderBold: true, TextColor: #e1e9ec, HorizontalAlignment: Center, VerticalAlignment: Center);
@Control = TextButtonStyle(Default: (Background: #293e54, LabelStyle: @ControlLabel), Hovered: (Background: #405a70, LabelStyle: @ControlLabel), Pressed: (Background: #587286, LabelStyle: @ControlLabel), Disabled: (Background: #1c2c3d, LabelStyle: (...@ControlLabel, TextColor: #91a5b2)), Sounds: $C.@ButtonSounds);
@Tooltip = TextTooltipStyle(Background: (TexturePath: "../Common/TooltipDefaultBackground.png", Border: 24), MaxWidth: 300, LabelStyle: (Wrap: true, FontSize: 14), Padding: 16);
Group { Background: #070d16(0.45); }
$C.@Container #Furnace { @CloseButton = false; Anchor: (Width: 680, Height: 808);
  #Title { Anchor: (Top: 0, Height: 44); Padding: (Full: 0); Label { Anchor: (Left: 28, Top: 0, Width: 500, Height: 44); Text: "BLOOD FURNACE"; Style: (...$C.@TitleStyle, FontSize: 18, HorizontalAlignment: Start); } TextButton #Close { Anchor: (Right: 28, Top: 8, Width: 72, Height: 28); Text: "Close"; Style: @Control; } }
  #Content { Anchor: (Top: 44); LayoutMode: Full; Padding: (Full: 0); Group #Body { Anchor: (Left: 28, Top: 12, Width: 624, Height: 744); LayoutMode: Full;
    TextField #PageKeyboard { Anchor: (Left: 0, Top: 0, Width: 1, Height: 1); AutoFocus: true; HitTestVisible: false; MaxLength: 1; Background: #070d16(0); Style: (FontSize: 1, TextColor: #d4e1e8(0)); Value: ""; }
    Group #FuelPanel { Anchor: (Left: 0, Top: 16, Width: 170, Height: 250); Background: #111e2c; }
    Group #InputPanel { Anchor: (Left: 180, Top: 16, Width: 196, Height: 250); Background: #111e2c; }
    Group #OutputPanel { Anchor: (Left: 386, Top: 16, Width: 238, Height: 250); Background: #111e2c; }
    Label #FuelHeading { Anchor: (Left: 0, Top: 29, Width: 170, Height: 22); Text: "BLOOD FUEL"; Style: (FontSize: 12, TextColor: #d89aa6, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true); }
    Label #FuelHint { Anchor: (Left: 0, Top: 53, Width: 170, Height: 22); Text: "1 droplet = 5 min"; Style: (FontSize: 12, TextColor: #d9e4ea, RenderBold: false, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true); }
    Label #InputHeading { Anchor: (Left: 180, Top: 29, Width: 196, Height: 22); Text: "INPUTS"; Style: (FontSize: 12, TextColor: #d9e4ea, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true); }
    Label #OutputHeading { Anchor: (Left: 386, Top: 29, Width: 238, Height: 22); Text: "OUTPUTS"; Style: (FontSize: 12, TextColor: #d9e4ea, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true); }
    Button #Machine0 { Anchor: (Left: 53, Top: 88, Width: 64, Height: 64); Style: @Slot; TextTooltipStyle: @Tooltip; ItemSlot #MachineItem0 { Anchor: (Full: 0); HitTestVisible: false; ShowQualityBackground: true; ShowQuantity: true; ShowDurabilityBar: false; } }
    TextField #MachineToken0 { Visible: false; Value: ""; }
    Label #FuelTime { Anchor: (Left: 0, Top: 161, Width: 170, Height: 30); Text: "0:00"; Style: (FontSize: 24, TextColor: #d89aa6, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true); }
    Group #FuelTrack { Anchor: (Left: 31, Top: 198, Width: 108, Height: 7); Background: #0b1520; }
    Group { Anchor: (Left: 31, Top: 198, Width: 108, Height: 7); Group #FuelFill { Anchor: (Left: 0, Top: 0, Width: 0, Height: 7); Background: #b85a70; } }
    TextButton #Toggle { Anchor: (Left: 22, Top: 222, Width: 126, Height: 28); Style: @Control; Text: "Pause"; }
    Button #Machine1 { Anchor: (Left: 206, Top: 84, Width: 56, Height: 56); Style: @Slot; TextTooltipStyle: @Tooltip; ItemSlot #MachineItem1 { Anchor: (Full: 0); HitTestVisible: false; ShowQualityBackground: true; ShowQuantity: true; ShowDurabilityBar: false; } }
    TextField #MachineToken1 { Visible: false; Value: ""; }
