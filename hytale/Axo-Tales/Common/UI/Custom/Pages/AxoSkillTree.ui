$C = "../Common.ui";
@NodeStyle = ButtonStyle(Default: (Background: (TexturePath: "../Textures/SkillTree298/NodeLocked.png")), Hovered: (Background: (TexturePath: "../Textures/SkillTree298/NodeHover.png")), Pressed: (Background: (TexturePath: "../Textures/SkillTree298/NodeSelected.png")), Sounds: $C.@ButtonSounds);
@ControlLabel = LabelStyle(FontName: "Secondary", FontSize: 15, RenderBold: true, TextColor: #f1e4c2, HorizontalAlignment: Center, VerticalAlignment: Center);
@Control = TextButtonStyle(Default: (Background: #234e55, LabelStyle: @ControlLabel), Hovered: (Background: #386c73, LabelStyle: @ControlLabel), Pressed: (Background: #507f80, LabelStyle: @ControlLabel), Disabled: (Background: #c3b18d, LabelStyle: (...@ControlLabel, TextColor: #534b38)), Sounds: $C.@ButtonSounds);
Group { Background: #030b12(0.78); }
Group #SkillTree { Anchor: (Width: 1180, Height: 720); Background: (TexturePath: "../Textures/SkillTree298/Board.png");
 Group #Content { LayoutMode: Full;
 TextField #SkillTreeKeyboard { Anchor: (Left: 0, Top: 0, Width: 1, Height: 1); AutoFocus: true; HitTestVisible: false; MaxLength: 1; Background: #000000(0); Style: (FontSize: 1, TextColor: #ffffff(0)); Value: ""; }
 Label #Title { Anchor: (Left: 78, Top: 20, Width: 620, Height: 40); Text: "Arbor Arcanum"; Style: (FontName: "Secondary", FontSize: 30, RenderBold: true, TextColor: #f3e3be); }
 Label { Anchor: (Left: 80, Top: 62, Width: 580, Height: 20); Text: "Select a rune to see its gifts and cost."; Style: (FontSize: 12, TextColor: #c1cebf); }
 Label #RuneCount { Anchor: (Left: 727, Top: 22, Width: 270, Height: 28); Text: "0 runes"; Style: (FontName: "Secondary", FontSize: 22, RenderBold: true, TextColor: #f0d595, HorizontalAlignment: End); }
 Label #LearnedCount { Anchor: (Left: 727, Top: 54, Width: 270, Height: 18); Text: "1 / 17 learned"; Style: (FontSize: 12, TextColor: #c1cebf, HorizontalAlignment: End); }
 TextButton #Close { Anchor: (Right: 68, Top: 28, Width: 84, Height: 32); Text: "Close"; Style: @Control; }

 Group #CoreView { Anchor: (Left: 0, Top: 0, Width: 840, Height: 540);
