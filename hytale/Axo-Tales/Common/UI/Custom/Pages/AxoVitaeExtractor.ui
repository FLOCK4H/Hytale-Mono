$C = "../Common.ui";
@Slot = ButtonStyle(Default: (Background: #24374a), Hovered: (Background: #405b70), Pressed: (Background: #567386), Disabled: (Background: #1b2a3b));
@ControlLabel = LabelStyle(FontName: "Secondary", FontSize: 12, RenderBold: true, TextColor: #e1e9ec, HorizontalAlignment: Center, VerticalAlignment: Center);
@Control = TextButtonStyle(Default: (Background: #293e54, LabelStyle: @ControlLabel), Hovered: (Background: #405a70, LabelStyle: @ControlLabel), Pressed: (Background: #587286, LabelStyle: @ControlLabel), Disabled: (Background: #1c2c3d, LabelStyle: (...@ControlLabel, TextColor: #91a5b2)), Sounds: $C.@ButtonSounds);
@Tooltip = TextTooltipStyle(Background: (TexturePath: "../Common/TooltipDefaultBackground.png", Border: 24), MaxWidth: 300, LabelStyle: (Wrap: true, FontSize: 14), Padding: 16);
Group { Background: #070d16(0.45); }
$C.@Container #Extractor { @CloseButton = false; Anchor: (Width: 600, Height: 808);
  #Title { Anchor: (Top: 0, Height: 44); Padding: (Full: 0); Label { Anchor: (Left: 28, Top: 0, Width: 420, Height: 44); Text: "VITAE EXTRACTOR"; Style: (...$C.@TitleStyle, FontSize: 18, HorizontalAlignment: Start); } TextButton #Close { Anchor: (Right: 24, Top: 8, Width: 64, Height: 28); Text: "Close"; Style: @Control; } }
  #Content { Anchor: (Top: 44); LayoutMode: Full; Padding: (Full: 0); Group #Body { Anchor: (Full: 0); LayoutMode: Full;
    TextField #PageKeyboard { Anchor: (Left: 0, Top: 0, Width: 1, Height: 1); AutoFocus: true; HitTestVisible: false; MaxLength: 1; Background: #070d16(0); Style: (FontSize: 1, TextColor: #d4e1e8(0)); Value: ""; }
    Label #Species { Anchor: (Left: 36, Top: 26, Width: 184, Height: 46); Text: "Species-bound DNA"; Style: (FontSize: 18, TextColor: #d9e4ea, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true); }
    Label #WorkState { Anchor: (Left: 36, Top: 80, Width: 184, Height: 46); Text: "Add a blood sample"; Style: (FontSize: 13, TextColor: #c9d6df, RenderBold: false, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true); }
    Label  { Anchor: (Left: 382, Top: 22, Width: 142, Height: 18); Text: "EXTRACTION"; Style: (FontSize: 11, TextColor: #c9b68e, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }
    Group { Anchor: (Left: 382, Top: 48, Width: 132, Height: 8); Background: #0d1926; Group #ProgressFill { Anchor: (Left: 0, Top: 0, Width: 0, Height: 8); Background: #b9d67e; } }
    Label #ProgressText { Anchor: (Left: 382, Top: 66, Width: 150, Height: 34); Text: "1 blood + 1 essence"; Style: (FontSize: 12, TextColor: #d9e4ea, RenderBold: false, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true); }
    Label  { Anchor: (Left: 218, Top: 92, Width: 164, Height: 22); Text: "Essence of Life"; Style: (FontSize: 12, TextColor: #d9e4ea, RenderBold: false, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: false); }
    Group { Anchor: (Left: 298, Top: 120, Width: 4, Height: 24); Background: #758b99; }
    Group { Anchor: (Left: 190, Top: 140, Width: 220, Height: 4); Background: #758b99; }
