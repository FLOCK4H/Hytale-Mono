$C = "../Common.ui";
@SpellStyle = ButtonStyle(
  Default: (Background: #142336(0.0)),
  Hovered: (Background: (TexturePath: "../AxoTales/SpellHover.png")),
  Pressed: (Background: (TexturePath: "../AxoTales/SpellPressed.png")),
  Disabled: (Background: #142336(0.0))
);
@SpellTooltipStyle = TextTooltipStyle(
  Background: (TexturePath: "../Common/TooltipDefaultBackground.png", Border: 24),
  MaxWidth: 300, LabelStyle: (Wrap: true, FontSize: 14), Padding: 16
);
@Backdrop = ButtonStyle(Default: (Background: #070d16(0.22)), Hovered: (Background: #070d16(0.22)), Pressed: (Background: #070d16(0.22)));
Button #WheelPage { Anchor: (Full: 0); Style: @Backdrop; }
Group #SpellWheel { Anchor: (Width: 760, Height: 740);
  Group #Wheel { Anchor: (Left: 0, Top: 20, Width: 760, Height: 660); Background: (TexturePath: "../AxoTales/SpellWheel.png"); }
  Label { Anchor: (Top: 0, Width: 760, Height: 34); Text: "Arcane Wand"; Style: (FontSize: 24, RenderBold: true, TextColor: #e4dbc3, HorizontalAlignment: Center); }
  Group { Anchor: (Left: 264, Top: 260, Width: 232, Height: 192); LayoutMode: Top;
    Label #Selected { Anchor: (Height: 30); Style: (FontSize: 20, RenderBold: true, TextColor: #e4dbc3, HorizontalAlignment: Center, ShrinkTextToFit: true); }
    Label #Summary { Anchor: (Height: 45); Style: (FontSize: 14, TextColor: #b8cddd, HorizontalAlignment: Center, Wrap: true); }
    Label #Detail { Anchor: (Height: 96); Style: (FontSize: 15, TextColor: #dce7ef, HorizontalAlignment: Center, Wrap: true); }
  }
  Button #SpellSilver { Anchor: (Left: 348, Top: 61, Width: 64, Height: 66); Style: @SpellStyle; TextTooltipStyle: @SpellTooltipStyle;
    ItemIcon #IconSilver { Anchor: (Left: 16, Top: 2, Width: 32, Height: 32); ItemId: "Book_Silver_Texture"; }
    Label { Anchor: (Top: 32, Width: 64, Height: 20); Text: "Silver"; Style: (FontSize: 13, RenderBold: true, TextColor: #e0eaf0, HorizontalAlignment: Center, ShrinkTextToFit: true); }
    Label #CostSilver { Anchor: (Top: 49, Width: 64, Height: 18); Style: (FontSize: 11, TextColor: #bfd1df, HorizontalAlignment: Center, ShrinkTextToFit: true); }
    Group #MarkerSilver { Anchor: (Left: 0, Top: 0, Width: 64, Height: 66); Background: (TexturePath: "../AxoTales/SpellSelected.png"); Visible: false; }
  }
  Button #SpellHeal { Anchor: (Left: 440, Top: 78, Width: 64, Height: 66); Style: @SpellStyle; TextTooltipStyle: @SpellTooltipStyle;
    ItemIcon #IconHeal { Anchor: (Left: 16, Top: 2, Width: 32, Height: 32); ItemId: "Book_Heal_Texture"; }
    Label { Anchor: (Top: 32, Width: 64, Height: 20); Text: "Healing"; Style: (FontSize: 13, RenderBold: true, TextColor: #e0eaf0, HorizontalAlignment: Center, ShrinkTextToFit: true); }
    Label #CostHeal { Anchor: (Top: 49, Width: 64, Height: 18); Style: (FontSize: 11, TextColor: #bfd1df, HorizontalAlignment: Center, ShrinkTextToFit: true); }
    Group #MarkerHeal { Anchor: (Left: 0, Top: 0, Width: 64, Height: 66); Background: (TexturePath: "../AxoTales/SpellSelected.png"); Visible: false; }
  }
  Button #SpellTeleport { Anchor: (Left: 520, Top: 128, Width: 64, Height: 66); Style: @SpellStyle; TextTooltipStyle: @SpellTooltipStyle;
    ItemIcon #IconTeleport { Anchor: (Left: 16, Top: 2, Width: 32, Height: 32); ItemId: "Book_Teleport_Texture"; }
