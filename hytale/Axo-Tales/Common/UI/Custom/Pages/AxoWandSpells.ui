  TextField #WheelKeyboard { Anchor: (Left: 0, Top: 0, Width: 1, Height: 1); AutoFocus: true; HitTestVisible: false; MaxLength: 1; Background: #070d16(0); Style: (FontSize: 1, TextColor: #d4e1e8(0)); Value: ""; }
  $C.@TextButton #CloseButton { @Text = "Close · Space / Esc"; Anchor: (Left: 280, Top: 676, Width: 200, Height: 34); }
  Label { Anchor: (Top: 716, Width: 760, Height: 22); Text: "LMB: spell wheel   RMB: cast   Crouch + RMB: alternate action"; Style: (FontSize: 14, TextColor: #c3d4df, HorizontalAlignment: Center); }
