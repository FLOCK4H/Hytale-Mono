items.flock4h.sar_boots.name = Sa'r Boots
items.flock4h.sar_boots.description = While worn, grants +25 max mana, +2 mana every 2s, +10 max stamina, +25% stamina regen, +8% defense, faster movement, higher jumps, one extra mid-air jump, and fall damage immunity.\n<color is="#d8b86a"><b>Full Sa'r set</b></color>: +35% movement speed, +30% maximum health and mana, 12.5% damage absorption and +100% crafting speed, in addition to each piece's perks. Permanently unlocks 18 bonus backpack slots.
items.flock4h.sar_diadem.name = Sa'r Diadem
items.flock4h.sar_diadem.description = While worn, grants +25 health, +25 max mana, +10 max stamina, +25% stamina regen, +8% defense, underwater breathing, and faster swimming.\n<color is="#d8b86a"><b>Full Sa'r set</b></color>: +35% movement speed, +30% maximum health and mana, 12.5% damage absorption and +100% crafting speed, in addition to each piece's perks. Permanently unlocks 18 bonus backpack slots.
items.flock4h.sar_chest.name = Sa'r Armor
items.flock4h.sar_chest.description = While worn, grants +75 health, +25 max mana, +10 max stamina, +25% stamina regen, +8% defense, and +25% physical/projectile damage dealt.\n<color is="#d8b86a"><b>Full Sa'r set</b></color>: +35% movement speed, +30% maximum health and mana, 12.5% damage absorption and +100% crafting speed, in addition to each piece's perks. Permanently unlocks 18 bonus backpack slots.
items.flock4h.sar_warfists.name = Sa'r Warfists
items.flock4h.sar_warfists.description = While worn, grants +25 health, +25 max mana, +10 max stamina, +25% stamina regen, +8% defense, and fires a 25-damage 2s-stun bolt on unarmed primary attacks.\n<color is="#d8b86a"><b>Full Sa'r set</b></color>: +35% movement speed, +30% maximum health and mana, 12.5% damage absorption and +100% crafting speed, in addition to each piece's perks. Permanently unlocks 18 bonus backpack slots.
items.flock4h.invisibility_cloak.name = Invisibility Cloak
items.flock4h.invisibility_cloak.description = While worn, hides your character and equipment from players and conceals you from creatures.
items.flock4h.custom_placeholder_block.name = Custom Placeholder Block
items.flock4h.custom_placeholder_block.description = A debug marker block used for testing Axo Tales worldgen.
items.flock4h.cloud_block.name = Cloud Block
items.flock4h.cloud_block.description = A cloud bank that boosts your motion in the direction you enter it.
items.flock4h.bounce_block.name = Bounce Block
items.flock4h.bounce_block.description = A forged spring block that launches you higher with each chained bounce.
items.flock4h.arcane_matter_ore_stone.name = Arcane Matter Ore (Stone)
items.flock4h.arcane_matter_ore_stone.description = A strange ore formation threaded through stone.
items.flock4h.arcane_matter_ore_volcanic.name = Arcane Matter Ore (Volcanic)
items.flock4h.arcane_matter_ore_volcanic.description = A strange ore formation fused into volcanic rock.
items.flock4h.arcane_matter.name = Arcane Matter
items.flock4h.arcane_grass.name = Arcane Grass
items.flock4h.arcane_grass.description = Grass steeped in arcane energy.
